# Discord Bot Token (REQUIRED)
TOKEN=

# MongoDB Connection URI (REQUIRED for database features like AI, Economy, Levels, etc.)
MONGO_URI=

# OpenRouter API Key for AI features (REQUIRED for AI chat)
# Get one at: https://openrouter.ai/keys
# Users can also use their own API keys with /ai set-api
OPENROUTER_API_KEY=

# Bot Website URLs (optional)
WEBSITE_URL=
BOT_INVITE_URL=
SUPPORT_SERVER_URL=
TOPGG_URL=

# Logging Channel IDs (optional - leave empty to disable specific logs)
DEBUG_CHANNEL=
UPLOADS_CHANNEL=
VOTES_CHANNEL=
CHATBOT_CHANNEL=
CHANGELOGS_CHANNEL=

# Bot Owner Discord User IDs (comma-separated for multiple owners)
OWNERS=